{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" } ] },
    { "source": "/(og-image.png|icon-192.png|icon-512.png|apple-touch-icon.png|favicon.ico)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] }
  ]
}
